page {
  stack {
    width: 220px
    padding: 12px
    gap: 10px

    heading {
      width: 120px
      content: "A heading that wraps"
    }

    text {
      width: 88px
      content: "Words wrap at spaces"
    }

    box {
      width: 70px
      "supercalifragilistic"
    }

    text {
      width: 100px
      content: "hard\n\nbreak"
    }

    button {
      width: 90px
      align: "center"
      justify: "center"
      "A button label wraps"
    }
  }
}
